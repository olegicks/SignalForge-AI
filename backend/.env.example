# Copy to backend/.env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# Separate, disposable database used only by pytest (all tables are dropped).
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/signalforge_test

OPENAI_API_KEY=sk-...
# Cheapest current small model, set by you.
OPENAI_MODEL=
# Only for reasoning models (e.g. none, minimal or low, whichever the model supports),
# so reasoning does not eat the output cap.
OPENAI_REASONING_EFFORT=
# USD per 1M tokens for OPENAI_MODEL, used for the per-run cost estimate.
OPENAI_PRICE_INPUT_PER_1M=0
OPENAI_PRICE_OUTPUT_PER_1M=0

MAX_NEWS_PER_TICKER=8
NEWS_LOOKBACK_HOURS=48
MAX_TICKERS_PER_RUN=30
LLM_MAX_OUTPUT_TOKENS=400

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
