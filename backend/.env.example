# Copy to backend/.env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
# Separate, disposable database used only by pytest (all tables are dropped).
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/signalforge_test

OPENAI_API_KEY=sk-...
# Cheapest current small model, set by you.
OPENAI_MODEL=
# Only for reasoning models (e.g. none, minimal or low, whichever the model supports),
# so reasoning does not eat the output cap.
OPENAI_REASONING_EFFORT=
# USD per 1M tokens for OPENAI_MODEL, used for the per-run cost estimate.
OPENAI_PRICE_INPUT_PER_1M=0
OPENAI_PRICE_OUTPUT_PER_1M=0

# Embeddings for "Ask the news" (RAG). Leave the model empty to disable embedding.
# e.g. text-embedding-3-small
OPENAI_EMBEDDING_MODEL=
# Vector size, fixed in the database by migration 0003. 512 keeps Neon's free storage in check.
EMBEDDING_DIM=512
OPENAI_EMBEDDING_PRICE_PER_1M=0
EMBEDDING_BATCH_SIZE=100

# POST /ask. Retrieval: top-k items, dropping anything below the cosine similarity.
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.30
ASK_MAX_OUTPUT_TOKENS=500
# Cost protection: per client IP per minute, and for the whole API per UTC day.
ASK_RATE_LIMIT_PER_MINUTE=5
ASK_DAILY_LIMIT=200

MAX_NEWS_PER_TICKER=8
NEWS_LOOKBACK_HOURS=48
MAX_TICKERS_PER_RUN=30
LLM_MAX_OUTPUT_TOKENS=400

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
